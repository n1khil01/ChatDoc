# Copy to .env and fill in. Never commit .env.

# Gemini API — separate keys for eval vs. the deployed app so a demo can't burn eval budget
GEMINI_API_KEY=
GEMINI_EVAL_API_KEY=

# Postgres (Neon) — pgvector enabled, halfvec
DATABASE_URL=

# Cloudflare R2 — PDF blob storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Auth
SESSION_SECRET=
SESSION_COOKIE_NAME=chatdoc_session

# Cost / quota controls
MAX_LLM_CALLS=
GEMINI_DAILY_BUDGET=

# Frontend
VITE_API_BASE_URL=

# Phase 1: local Postgres + pgvector (docker-compose up -d)
DATABASE_URL=postgresql://chatdoc:chatdoc@localhost:5432/chatdoc
